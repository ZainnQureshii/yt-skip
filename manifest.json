{
  "manifest_version": 3,
  "name": "YT Skip",
  "version": "1.0.0",
  "description": "Mutes a YouTube ad and clicks Skip the moment the button becomes clickable. Runs only on youtube.com.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["skipper.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

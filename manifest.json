{
  "manifest_version": 3,
  "name": "YT Skip",
  "version": "1.2.0",
  "description": "Silences YouTube ads, runs them at speed, and skips them the moment the skip button appears. Runs only on youtube.com.",
  "permissions": ["debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["skipper.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
